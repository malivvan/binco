{{/* spec.VersionedType */}}
{{- $v := Serializer.Val . }}
{{- $fulp := Tmpl.UnmarshalLastParam true .Gops }}
{{- $ulp := Tmpl.UnmarshalLastParam false .Gops }}
dtm, n, err := typeid.DTMSerializer.Unmarshal({{ $fulp }})
if err != nil {
	return
}
var n1 int
switch dtm {
{{- range $i, $e := .Versions }}
    {{- $vopt := index $.Vops.Versions $i }}
	case {{ Serializer.DTMVar $e }}:
		var tmp {{ Serializer.RelName $e }}
		tmp, n1, err = {{ Serializer.TypedVar $e }}.UnmarshalData({{ $ulp }})
		if err != nil {
			return
		}
        {{- if ne $vopt.Migration "" }}
		{{ $v }} = {{ $vopt.Migration }}(tmp)
        {{- else }}
		{{ $v }} = {{ Serializer.RelName $.FullName }}(tmp)
        {{- end }}
{{- end }}
	default:
		err = binco.NewUnexpectedDTMError(dtm)
		return
}
n += n1
return