{{/* {Map: map[data.AnonSerializerName]data.AnonData, Ops: genopts.Options} */}}
{{- if gt (len .Map)  0 }}
	{{- $gops := .Ops }}
	var (
		{{- range $name, $ad := .Map }}
{{- /* string type */}}
			{{- if eq $ad.Kind.String "string" }}
				{{ $name }} = composite.NewStringSerializer({{ Serializer.StringOpts $ad }})
			{{- end }}
{{- /* array type */}}
			{{- if eq $ad.Kind.String "array" }}
				{{ $name }} = zerocopy.NewArraySerializer[{{ Serializer.RelName $ad.ArrType }}]({{ Serializer.Elem $ad $gops }}{{ Tmpl.WithComma (Serializer.ArrayOpts $ad) }})
			{{- end }}
{{- /* byte slice type */}}
			{{- if eq $ad.Kind.String "byteSlice" }}
				{{ $name }} = composite.NewByteSliceSerializer({{ Serializer.ByteSliceOpts $ad }})
			{{- end }}
{{- /* slice type */}}
			{{- if eq $ad.Kind.String "slice" }}
				{{ $name }} = composite.NewSliceSerializer[{{ Serializer.RelName $ad.ElemType }}]({{ Serializer.Elem $ad $gops }}{{ Tmpl.WithComma (Serializer.SliceOpts $ad) }})
			{{- end }}
{{- /* map type */}}
			{{- if eq $ad.Kind.String "map" }}
				{{ $name }} = composite.NewMapSerializer[{{ Serializer.RelName $ad.KeyType }}, {{ Serializer.RelName $ad.ElemType }}]({{ Serializer.Key $ad $gops }}, {{ Serializer.Elem $ad $gops }}{{ Tmpl.WithComma (Serializer.MapOpts $ad) }})
			{{- end }}
{{- /* ptr type */}}
			{{- if eq $ad.Kind.String "ptr" }}
				{{ $name }} = composite.NewPtrSerializer[{{ Serializer.RelName $ad.ElemType }}]({{ Serializer.Elem $ad $gops }})
			{{- end }}
		{{- end }}
	)
{{- end }}
