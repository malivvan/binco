{{/* spec.InterfaceType */}}
{{- $v := Serializer.Val . }}
{{- $mlp := Tmpl.MarshalLastParam true .Gops }}
{{- if .Iops.Marshaller }}
	if m, ok := {{ $v }}.({{ Tmpl.ModImportName .Gops }}.MarshallerTyped); ok {
		return m.MarshalTypedBinco({{ $mlp }})
	}
	panic(fmt.Sprintf("%v doesn't implement the {{ Tmpl.ModImportName .Gops }}.MarshallerTyped interface", reflect.TypeOf({{ $v }})))
{{- else }}
	switch t := {{ $v }}.(type) {
		{{- range $e := .Impls }}
			case {{ Serializer.RelName $e }}:
				return {{ Serializer.TypedVar $e }}.Marshal(t, {{ $mlp }})
		{{- end }}
			default:
				panic(fmt.Sprintf(binco.ErrorPrefix+"unexpected %v type", t))
	}
{{- end }}
